{
  "expo": {
    "name": "MyFlow",
    "slug": "myflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/myflow-icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "myflow",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myflow.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101010",
        "foregroundImage": "./assets/myflow-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.myflow.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/myflow-icon.png",
          "color": "#B5A0FF",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
